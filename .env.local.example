NEXT_PUBLIC_KLEMSTORE_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_KLEMSTORE_TENANT_ID=
# Dev/demo tenant (klemstore.demo-tenant-id in klemstore-core-api application.yml).
# The frontend cannot reach the API without this: isCoreApiConfigured() requires both
# the base URL and the tenant id. NEXT_PUBLIC_* values are inlined at BUILD time,
# so changing this requires a rebuild -- not just a restart.
# Dev: 759561e1-7e6c-4272-afcd-3023b3ec6c54
# Local-only test token. Production should use the authenticated session boundary.
NEXT_PUBLIC_KLEMSTORE_ACCESS_TOKEN=
